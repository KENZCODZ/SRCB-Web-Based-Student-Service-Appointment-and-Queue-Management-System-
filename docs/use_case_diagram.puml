@startuml
title EduQueue: Web-Based Student Service Appointment and Queue Management System\nComprehensive Use Case Diagram (SRCB S.Y. 2025-2026)

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Arial, sans-serif"
skinparam defaultFontSize 12

skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #1E3A8A
    FontColor #0F172A
    FontStyle bolda
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    FontColor #1E293B
    ArrowColor #3B82F6
}

skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #CBD5E1
    FontColor #1E3A8A
    FontStyle bold
}

' ==========================================
' ACTORS
' ==========================================
actor "Student / Client" as Student
actor "Department Staff" as Staff
actor "System Administrator" as Admin
actor "Public Lobby Monitor" as Display
actor "Transactional Email Service\n(Resend / Brevo / SendGrid / SMTP)" as MailService <<External System>>

' ==========================================
' SYSTEM BOUNDARY
' ==========================================
rectangle "EduQueue System Boundary" {
    
    package "Authentication & Identity Management" {
        usecase "Register Student Account" as UC_Reg
        usecase "Login / Authenticate (JWT)" as UC_Login
        usecase "One-Click Demo Autofill Login" as UC_DemoLogin
        usecase "Manage Profile Details" as UC_Profile
        usecase "Change Account Password" as UC_ChangePass
        usecase "Logout & Terminate Session" as UC_Logout
    }

    package "Student Self-Services" {
        usecase "Browse Service Catalog & Requirements" as UC_Browse
        usecase "Check Available Time Slots" as UC_CheckSlots
        usecase "Book Service Appointment" as UC_BookApt
        usecase "View My Appointments" as UC_ViewApts
        usecase "Cancel Pending / Approved Booking" as UC_CancelApt
        usecase "Join Walk-In Queue (Get Ticket)" as UC_JoinQueue
        usecase "Track Live Queue Position & ETA" as UC_TrackQueue
        usecase "Cancel Active Queue Ticket" as UC_CancelQueue
        usecase "Access In-App Notification Center" as UC_NotifCenter
    }

    package "Staff Counter & Appointment Operations" {
        usecase "Review & Filter Appointments" as UC_ReviewApt
        usecase "Approve Appointment Request" as UC_ApproveApt
        usecase "Decline Appointment with Justification" as UC_DeclineApt
        usecase "Reschedule Appointment Slot" as UC_RescheduleApt
        usecase "Select Desk & Counter Window" as UC_SelectCounter
        usecase "Call Next Waiting Student" as UC_CallNext
        usecase "Start Serving Student" as UC_ServeTicket
        usecase "Complete Service Transaction" as UC_CompleteTicket
        usecase "Mark Ticket as Skipped (No-Show)" as UC_SkipTicket
    }

    package "Public Kiosk & Lobby Display" {
        usecase "Display Live Called Counters & Tickets" as UC_LobbyDisplay
        usecase "Play Audio Chime Alert on Turn Call" as UC_AudioAlert
        usecase "Display Department Waiting Tickers" as UC_WaitingSummary
        usecase "Display Institutional Digital Clock" as UC_DigitalClock
    }

    package "Administrative Control & System Governance" {
        usecase "View Operational Dashboard & KPIs" as UC_DashStats
        usecase "Inspect 7-Day Volume Trends" as UC_AnalyticsChart
        usecase "Manage Services (CRUD & Status Toggle)" as UC_ManageServices
        usecase "Configure Weekly Operating Schedules" as UC_ConfigureSchedules
        usecase "Provision Staff & Admin Accounts" as UC_ManageUsers
        usecase "Toggle User Status (Active / Disabled)" as UC_ToggleUserStatus
        usecase "Inspect System Security Audit Trail" as UC_AuditLogs
        usecase "Inspect Transactional Email Delivery Logs" as UC_EmailLogs
    }

    package "Automated Communication & Alerts" {
        usecase "Dispatch HTML Confirmation Voucher" as UC_SendEmailVoucher
        usecase "Dispatch Rejection Notice with Reason" as UC_SendEmailDecline
        usecase "Dispatch Reschedule Advisory Notice" as UC_SendEmailReschedule
        usecase "Push In-App Alert Notification" as UC_SendInAppNotif
    }
}

' ==========================================
' RELATIONSHIPS & ASSOCIATIONS
' ==========================================

' Student Actor Associations
Student --> UC_Reg
Student --> UC_Login
Student --> UC_DemoLogin
Student --> UC_Profile
Student --> UC_ChangePass
Student --> UC_Logout
Student --> UC_Browse
Student --> UC_CheckSlots
Student --> UC_BookApt
Student --> UC_ViewApts
Student --> UC_CancelApt
Student --> UC_JoinQueue
Student --> UC_TrackQueue
Student --> UC_CancelQueue
Student --> UC_NotifCenter

' Staff Actor Associations
Staff --> UC_Login
Staff --> UC_DemoLogin
Staff --> UC_Profile
Staff --> UC_ChangePass
Staff --> UC_Logout
Staff --> UC_ReviewApt
Staff --> UC_ApproveApt
Staff --> UC_DeclineApt
Staff --> UC_RescheduleApt
Staff --> UC_SelectCounter
Staff --> UC_CallNext
Staff --> UC_ServeTicket
Staff --> UC_CompleteTicket
Staff --> UC_SkipTicket

' Admin Actor Inheritance & Specializations
Admin --|> Staff
Admin --> UC_DashStats
Admin --> UC_AnalyticsChart
Admin --> UC_ManageServices
Admin --> UC_ConfigureSchedules
Admin --> UC_ManageUsers
Admin --> UC_ToggleUserStatus
Admin --> UC_AuditLogs
Admin --> UC_EmailLogs

' Public Display Monitor Associations
Display --> UC_LobbyDisplay
Display --> UC_AudioAlert
Display --> UC_WaitingSummary
Display --> UC_DigitalClock

' Use Case Inclusions & Triggers
UC_BookApt .> UC_CheckSlots : <<include>>
UC_BookApt ..> UC_SendInAppNotif : <<triggers>>

UC_JoinQueue ..> UC_SendInAppNotif : <<triggers>>

UC_ApproveApt ..> UC_SendEmailVoucher : <<triggers>>
UC_ApproveApt ..> UC_SendInAppNotif : <<triggers>>

UC_DeclineApt ..> UC_SendEmailDecline : <<triggers>>
UC_DeclineApt ..> UC_SendInAppNotif : <<triggers>>

UC_RescheduleApt ..> UC_SendEmailReschedule : <<triggers>>
UC_RescheduleApt ..> UC_SendInAppNotif : <<triggers>>

UC_CallNext ..> UC_LobbyDisplay : <<updates>>
UC_CallNext ..> UC_AudioAlert : <<triggers>>
UC_CallNext ..> UC_SendInAppNotif : <<triggers>>

UC_ServeTicket ..> UC_LobbyDisplay : <<updates>>
UC_CompleteTicket ..> UC_SendInAppNotif : <<triggers>>
UC_SkipTicket ..> UC_SendInAppNotif : <<triggers>>

' External Mail Service Integration
UC_SendEmailVoucher --> MailService
UC_SendEmailDecline --> MailService
UC_SendEmailReschedule --> MailService

@enduml
